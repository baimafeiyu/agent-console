{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentConsole",
  "version": "0.2.0",
  "identifier": "com.workbuddy.agent-console",
  "build": {
    "frontendDist": "../../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "智能体指挥台",
        "url": "http://127.0.0.1:8766",
        "width": 1280,
        "height": 840,
        "minWidth": 480,
        "minHeight": 600
      },
      {
        "label": "pet",
        "title": "鲸鱼娘",
        "url": "http://127.0.0.1:8766/pet.html",
        "width": 192,
        "height": 208,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
